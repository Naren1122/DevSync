// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Tier {
  FREE
  PRO
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id           String            @id @default(uuid())
  email        String            @unique
  passwordHash String
  name         String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  workspaces   WorkspaceMember[]
}

model Workspace {
  id               String            @id @default(uuid())
  name             String
  slug             String            @unique
  subscriptionTier Tier              @default(FREE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  members          WorkspaceMember[]
  boards           Board[]
}

// Join table to map Users to Workspaces with specific role permissions
model WorkspaceMember {
  id          String    @id @default(uuid())
  userId      String
  workspaceId String
  role        Role      @default(MEMBER)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId]) // A user can only join a specific workspace once
}

model Board {
  id          String    @id @default(uuid())
  name        String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId]) // Indexing for lightning-fast multi-tenant queries
}